<%- include("partials/head.ejs") %>
<%- include("partials/nav.ejs") %>

    <hr>
    <hr>
    <hr>

    <main>
        <h2><%= about %></h2>
    <hr>
    <hr>
    <hr>
        <section id="product-list" class="products"> <!--mi plantilla EJS-->
            <!--aca voy a iterar el array q me traigo de mi endpoint-->
            <% productos.forEach(prod => { %>
                <div class="card-products">
                    <img class="producto-img" src="/uploads/<%= prod.imagen %>" alt="<%= prod.nombre %>">
                    <h3><%=prod.nombre%></h3>
                    <p> id: <%=prod.id%></p>
                    <p><%=prod.precio%></p>
                    <button onclick="addToCart(<%= prod.id %>)">Agregar al carrito</button>
                </div>
            <% }); %>
        </section>
    <hr>
    <hr>
    <hr>
    <section id="cart-section">
            <div id="cart-counter-div">
                <h4>Carrito</h4>
                <div id="ul-carrito-div">
                    <ul id="cart-items"><li></li></ul>
                </div>
                <p id="total">Total $0</p>
            </div>
        </section>
        <div>
            <button id="reset-cart">Reset carrito</button>
        </div>
    </main>

<script src="/js/main.js"></script>
<%- include("partials/footer.ejs") %>



